# ==========================================
# MONGODB CONFIGURATION
# ==========================================
# Thay chuỗi bên dưới bằng Connection String từ MongoDB Atlas Cluster M0 của bạn:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=smart_aquarium_iot

# ==========================================
# DATADOG CONFIGURATION
# ==========================================
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_optional_for_provision_script
DD_SITE=datadoghq.com # Hoặc us5.datadoghq.com tùy region bạn đăng ký
DD_ENV=hackathon
DD_SERVICE=smart-aquarium-service
DD_VERSION=1.0.0
DD_LOGS_INJECTION=true

# ==========================================
# APP & SIMULATOR CONFIGURATION
# ==========================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
INGEST_BATCH_SIZE=20
INGEST_INTERVAL_SECONDS=2

# ==========================================
# FIREBASE REALTIME SYNC (OPTIONAL)
# ==========================================
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
